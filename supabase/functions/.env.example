# Supabase provides SUPABASE_URL and service-role/secret keys in hosted Edge Functions.

# Master runtime gate. Keep false until the explicit Google provider/staging gate is resumed.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://PROJECT_REF.supabase.co/functions/v1/google-oauth
GOOGLE_OAUTH_SUCCESS_URL=https://agenda.example.com/gestao/integracoes
GOOGLE_WEBHOOK_URL=https://PROJECT_REF.supabase.co/functions/v1/google-webhook
# Exact Google account allowed to complete OAuth in this environment.
GOOGLE_ALLOWED_ACCOUNT_EMAIL=test-calendar-account@example.com
# Sandbox safety rail: admin mapping refuses calendars whose visible name lacks this prefix.
GOOGLE_TEST_CALENDAR_PREFIX=TESTE

# Base64 of exactly 32 random bytes. Never reuse across unrelated environments.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Mercado Pago private credentials belong only in Supabase secrets, never in web/.env.
MERCADO_PAGO_ACCESS_TOKEN=replace-with-test-or-production-access-token
MERCADO_PAGO_WEBHOOK_SECRET=replace-with-webhook-signature-secret
MERCADO_PAGO_WEBHOOK_URL=https://PROJECT_REF.supabase.co/functions/v1/mercado-pago-webhook

# Kommo private-integration long-lived token. Edge secret only: never store it in
# Postgres, web/.env, browser code or repository secrets committed to source control.
KOMMO_ACCESS_TOKEN=replace-with-long-lived-private-integration-token

# Transactional email uses the Resend HTTP API because hosted Edge Functions cannot
# open outbound SMTP connections on ports 25/587. Keep automatic worker consumption
# disabled during the isolated allowlist/provider gate.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_WORKER_ENABLED=false
# Independent hard gate for birthday notification delivery. Keep false until the
# birthday worker has passed sandbox allowlist/provider smokes and the campaign is explicitly activated.
BIRTHDAY_EMAIL_DELIVERY_ENABLED=false
NOTIFICATION_TEMPLATES_RUNTIME_ENABLED=false
TRANSACTIONAL_EMAIL_SCOPES=BLACKSHEEP
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM_BLACKSHEEP="BlackSheep Estúdio Criativo <agenda@blacksheepestudiocriativo.com.br>"
EMAIL_REPLY_TO_BLACKSHEEP=agenda@blacksheepestudiocriativo.com.br
EMAIL_FROM_SABRINA=
EMAIL_REPLY_TO_SABRINA=
EMAIL_TEST_RECIPIENT_ALLOWLIST=
ALLOW_REAL_EMAIL_RECIPIENTS=false

# Random high-entropy secret used only for Edge-to-Edge worker calls.
INTEGRATION_INTERNAL_SECRET=replace-with-random-secret
