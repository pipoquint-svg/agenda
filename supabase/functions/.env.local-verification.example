# Item 1 local verification only. Copy to a temporary file if local overrides are needed.
# Every provider-looking value below is a non-secret placeholder.
APP_ENV=local_verification
MERCADO_PAGO_ENV=local_verification
MERCADO_PAGO_PRODUCTION_ACCESS_TOKEN=LOCAL_ONLY_do_not_use
MERCADO_PAGO_WEBHOOK_SECRET=LOCAL_ONLY_mp_webhook_secret
ALLOW_REAL_CHARGES=false
MERCADO_PAGO_3DS_MODE=never

GOOGLE_CLIENT_ID=LOCAL_ONLY_google_client
GOOGLE_CLIENT_SECRET=LOCAL_ONLY_google_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-oauth-callback
GOOGLE_TOKEN_ENCRYPTION_KEY=bG9jYWwtdmVyaWZpY2F0aW9uLWtleS0zMi1ieXRlcyE=
GOOGLE_WEBHOOK_CHANNEL_TOKEN=LOCAL_ONLY_google_channel_token

# Transactional e-mail is intentionally not configured. The local transport blocks
# every non-local host, so side effects cannot reach Resend or any other provider.
EMAIL_PROVIDER=disabled
