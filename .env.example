# Runtime environment
APP_ENV=production

# Supabase runtime
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative to SUPABASE_SERVICE_ROLE_KEY when using secret-key bundles:
SUPABASE_SECRET_KEYS=
INTEGRATION_INTERNAL_SECRET=

# Google Calendar runtime. Master gate remains false until the explicit provider/staging gate resumes.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_WATCH_WEBHOOK_URL=

# Mandatory integration-test isolation metadata.
# Sandbox calendars must all start with TESTE.
GOOGLE_TEST_PROJECT_ID=
GOOGLE_TEST_ACCOUNT_EMAIL=
GOOGLE_TEST_CALENDAR_PREFIX=TESTE
# Allowed durable strategies before the post-integration suite:
# OAUTH_PUBLICADO | WORKSPACE_DELEGATION
GOOGLE_AUTH_STRATEGY=
GOOGLE_GRANTED_SCOPES="openid email https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly"

# Mercado Pago production runtime.
# Only the official production-scoped credential is accepted by the operational backend.
MERCADO_PAGO_ENV=production
MERCADO_PAGO_PRODUCTION_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://sbexdggbwqvyhbkatucs.supabase.co/functions/v1/mercado-pago-webhook
# Keep false during credential/webhook installation. Enable only after the production
# webhook is registered and the provider readiness gate is verified.
ALLOW_REAL_CHARGES=false

# Public booking URL used to build recovery links.
# Must be HTTPS in staging/production.
PUBLIC_BOOKING_BASE_URL=

# Transactional email via the canonical Resend provider adapter.
# Every email path, including Supabase Auth, must route through
# supabase/functions/_shared/email-provider.ts.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_WORKER_ENABLED=false
TRANSACTIONAL_EMAIL_SCOPES=BLACKSHEEP
RESEND_API_KEY=
# Etapa 2 notification platform: confirmation, balance, birthday and admin test
# all use this canonical From/Reply-To identity. Operation scope controls only
# the brand rendered inside the shared email shell.
EMAIL_FROM_BLACKSHEEP="BlackSheep Estúdio Criativo <agenda@blacksheepestudiocriativo.com.br>"
EMAIL_REPLY_TO_BLACKSHEEP=agenda@blacksheepestudiocriativo.com.br
# Kept for the existing scoped sender contract (notably Supabase Auth) until the
# dedicated Auth convergence stage. Operational notifications do not use these.
EMAIL_FROM_SABRINA=
EMAIL_REPLY_TO_SABRINA=
EMAIL_TEST_RECIPIENT_ALLOWLIST=
ALLOW_REAL_EMAIL_RECIPIENTS=false

# Supabase Auth Send Email Hook. This secret authenticates the hook request; it is not
# an email-provider credential. Provider delivery still uses only RESEND_API_KEY.
AUTH_EMAIL_OPERATION_SCOPE=BLACKSHEEP
SEND_EMAIL_HOOK_SECRET=

# WhatsApp Cloud API / Meta (legacy direct integration; not used by Agenda V1).
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT_ALLOWLIST=

ALLOW_REAL_CUSTOMER_DATA=false
ALLOW_REAL_WHATSAPP_RECIPIENTS=false
# Never populate this while Google integration is disabled.
# PRODUCTION_CALENDAR_IDS=
