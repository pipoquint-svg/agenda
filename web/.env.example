VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public key only. The Mercado Pago Access Token must never be exposed to Vite/browser.
VITE_MERCADO_PAGO_PUBLIC_KEY=
# Explicit environment marker. Production hides the banner; non-production admin surfaces show it.
VITE_APP_ENV=production
# Public analytics identifiers. No secret belongs in Vite env.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
